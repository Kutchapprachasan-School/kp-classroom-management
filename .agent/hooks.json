{
  "multi-agent-conflict-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "replace_file_content|write_to_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/check_agent_conflicts.mjs --hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
