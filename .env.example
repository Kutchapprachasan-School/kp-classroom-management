# ====================================================================
# Classroom Management System (.env.example)
# Thai Secondary School Management SaaS — Kutchapprachasan School
# ====================================================================

# Remote Supabase Credentials (Dual-mode fallback operates seamlessly when omitted)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
VITE_SUPABASE_FAILOVER_URL="https://your-failover-project-id.supabase.co"
VITE_SUPABASE_FAILOVER_KEY="your-failover-anon-key"

# External Integrations
VITE_ELEAVE_PORTAL_URL="https://e-leave-system-kappa.vercel.app"

# PostgreSQL Database Connections (Prisma / Direct Pooler)
DATABASE_URL="postgresql://postgres.your-project-id:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-id:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
